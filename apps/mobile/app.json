{
  "expo": {
    "name": "masquerade",
    "slug": "masquerade",
    "version": "1.0.0",
    "scheme": "masquerade",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#000000" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.prophecytech.masquerade" },
    "android": { "package": "com.prophecytech.masquerade", "adaptiveIcon": { "backgroundColor": "#000000" } },
    "web": { "bundler": "metro", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
